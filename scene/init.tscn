[sub_resource type="GDScript" id="GDScript_afm41"]
resource_name = "main-menu-manager"
script/source = "extends HBoxContainer

@onready var play_button: Button = $VBoxContainer/Play
@onready var credits_button: Button = $VBoxContainer/Credits
@onready var quit_button: Button = $VBoxContainer/Quit
@onready var credits_cont: PanelContainer = $Credits
@onready var quit_cont: PanelContainer = $\"../../Quit\"

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	credits_button.button_up.connect(toggle.bind(credits_cont))
	quit_button.button_up.connect(toggle.bind(quit_cont))

func toggle(box: Control) -> void:
	var old := box.visible
	hide_all()
	box.visible = !old

func hide_all() -> void:
	credits_cont.visible = false
	quit_cont.visible = false
"

[sub_resource type="GDScript" id="GDScript_42rhp"]
resource_name = "open link"
script/source = "extends RichTextLabel

@export var link := \"https://github.com/Ortley/black-hole-stars\"

func _on_meta_clicked(meta: Variant) -> void:
	OS.shell_open(link)
"

