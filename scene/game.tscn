[sub_resource type="Shader" id="Shader_p1ry8"]
code = "
// NOTE: Shader automatically converted from Godot Engine 4.6.3.stable's ProceduralSkyMaterial.

shader_type sky;
render_mode use_debanding;

uniform float star_density;
uniform float star_brightness;
uniform vec3 star_color: source_color;

float hash(vec3 p) {
	p = fract(p * 0.1031);
	p += dot(p, p.zyx + 31.32);
	return fract((p.x + p.y) * p.z);
}

void sky() {
	
	vec3 dir = EYEDIR;
	float cos_theta = dot(dir, LIGHT0_DIRECTION);
	float sun_disc = smoothstep(1.0 - 0.005, 1.0 - 0.05 * (0.01 * 0.001), cos_theta);
	vec3 final_sun = sun_disc * star_color;
	
	vec3 star_grid = floor(dir * 200.0 * star_density);
	float star_noise = hash(star_grid);
	vec3 stars = vec3(0.0);
	
	if (star_noise > 0.995) {
		float star_intensity = pow(hash(star_grid + 0.5), 10.0) * star_brightness;
		stars = vec3(star_intensity);
	}
	
	stars *= (1.0 - sun_disc);
	
	COLOR = final_sun + stars;
	
}
"

